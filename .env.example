# Mihomo Controller API
MIHOMO_URL=http://127.0.0.1:9090
MIHOMO_SECRET=

# MMonitor HTTP listen address (Windows defaults to 127.0.0.1:8080, Linux/Docker defaults to :8080)
MMONITOR_LISTEN=:8080

# Optional SQLite database path override
# MMONITOR_DB=/data/mmonitor.db

# HTTP fallback poll interval when WebSocket is unavailable (ms, default 5000)
MMONITOR_POLL_INTERVAL_MS=5000

# In-memory aggregate flush interval (ms, default 600000 = 10 minutes)
MMONITOR_FLUSH_INTERVAL_MS=600000

# Default aggregated traffic retention days (1-365)
MMONITOR_RETENTION_DAYS=30

# Optional CORS allowed origin (empty = same-origin only)
MMONITOR_ALLOWED_ORIGIN=
